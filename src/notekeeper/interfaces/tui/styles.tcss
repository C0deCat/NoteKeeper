Screen {
    layout: vertical;
}

ModalScreen {
    align: center middle;
}

#topbar {
    layout: horizontal;
    width: 100%;
    height: 3;
    min-height: 3;
    padding: 0 1;
    background: $panel;
    overflow: hidden hidden;
}

#topbar-left {
    width: 78;
    height: 3;
}

#topbar-selectors {
    width: 57;
    height: 3;
}

#topbar-selectors > Select {
    width: 28;
    min-width: 24;
    max-width: 32;
    height: 3;
}

#campaign-select {
    margin-left: 1;
}

#topbar-actions {
    width: 20;
    height: 3;
    margin-left: 1;
}

#manage-campaign {
    width: 14;
    min-width: 14;
    height: 3;
}

#settings {
    width: 5;
    min-width: 5;
    height: 3;
    margin-left: 1;
}

#account-status {
    width: 1fr;
    height: 3;
    align: right middle;
}

#account-copy {
    width: auto;
    min-width: 7;
    max-width: 16;
    height: 2;
}

#job-count, #auth-user {
    width: 100%;
    height: 1;
    overflow: hidden hidden;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    content-align: right middle;
}

#logout {
    width: 5;
    min-width: 5;
    height: 3;
    margin-right: 0;
}

Button.icon-button {
    margin: 0;
    padding: 0;
    border: none !important;
    content-align: center middle;
    text-align: center;
}

#topbar.topbar-account-row {
    layout: vertical;
    height: 6;
}

#topbar.topbar-account-row #account-status,
#topbar.topbar-action-row #account-status,
#topbar.topbar-selector-rows #account-status {
    width: 100%;
}

#topbar.topbar-action-row {
    layout: vertical;
    height: 9;
}

#topbar.topbar-action-row #topbar-left,
#topbar.topbar-selector-rows #topbar-left {
    layout: vertical;
    width: 100%;
}

#topbar.topbar-action-row #topbar-left {
    height: 6;
}

#topbar.topbar-action-row #topbar-actions,
#topbar.topbar-selector-rows #topbar-actions {
    margin-left: 0;
}

#topbar.topbar-selector-rows {
    layout: vertical;
    height: 12;
}

#topbar.topbar-selector-rows #topbar-left {
    height: 9;
}

#topbar.topbar-selector-rows #topbar-selectors {
    layout: vertical;
    width: 100%;
    height: 6;
}

#topbar.topbar-selector-rows #campaign-select {
    margin-left: 0;
}

.auth-modal {
    width: 52;
}

.auth-modal Input {
    margin-top: 1;
}

.auth-error {
    min-height: 1;
    margin: 1 0;
    color: $error;
}

#campaign-actions {
    width: 100%;
    height: auto;
    min-height: 1;
    margin-top: 1;
    padding: 0 1;
    grid-columns: auto;
    grid-rows: 1;
    grid-gutter: 0 1;
    background: $panel;
}

#campaign-actions Button {
    width: auto;
    height: 1;
    min-width: 0;
    border: none;
    padding: 0 1;
}

#dashboard {
    height: 1fr;
    overflow-y: auto;
}

#actions {
    width: 28;
    height: 1fr;
    padding: 1;
    background: $surface;
    overflow-y: auto;
}

#actions Button {
    width: 100%;
    margin-bottom: 1;
}

#content {
    width: 1fr;
    padding: 1;
    overflow-y: auto;
    overflow-x: auto;
}

#content Button {
    width: auto;
    height: 1;
    min-width: 0;
    border: none;
    padding: 0 1;
}

#jobs-header {
    height: 1;
    align: left middle;
}

#jobs-header Label {
    width: 1fr;
    content-align: left middle;
}

#clear-failed-jobs {
    width: auto;
    min-width: 20;
}

.panel {
    height: 1fr;
    border: solid $accent;
    padding: 1;
    margin-bottom: 1;
}

.short-panel {
    height: 12;
}

.modal {
    width: 72;
    max-width: 95%;
    height: auto;
    max-height: 95%;
    padding: 0;
    border: none;
    outline: none;
    background: transparent;
    overflow: hidden hidden;
}

.modal-body Button {
    margin-right: 1;
}

.modal-header {
    width: 100%;
    height: 3;
    min-height: 3;
    padding: 0;
    background: $surface;
    align: left middle;
}

.modal-title {
    width: 1fr;
    height: 3;
    content-align: left middle;
    padding-left: 1;
    text-style: bold;
}

.modal Button.modal-close {
    width: 3;
    min-width: 3;
    height: 3;
    margin: 0;
    padding: 0;
    border: none;
    background: $error;
    color: $text;
    content-align: center middle;
}

.modal Button.modal-close:hover {
    background: $error-darken-1;
}

.modal-body {
    width: 100%;
    height: auto;
    max-height: 75vh;
    padding: 1 2;
    background: $panel;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-gutter: stable;
}

.modal.modal-constrained {
    height: 95%;
}

.modal.modal-constrained > .modal-body {
    height: 1fr;
    max-height: 1fr;
}

.large-modal {
    width: 90%;
    height: 90%;
    max-width: 90%;
    max-height: 90%;
}

.large-modal > .modal-body {
    height: 1fr;
    max-height: 1fr;
}

.modal-actions {
    width: 100%;
    height: 3;
    min-height: 3;
    margin-top: 1;
    margin-bottom: 1;
    align: left middle;
}

.form-group {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

.form-group > Label {
    height: 1;
}

.form-group > Input, .form-group > Select {
    margin: 0;
}

.form-group-row {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

.modal-body Button.form-action {
    width: auto;
    margin: 0 1 2 0;
}

.settings-menu > .modal-body > Button {
    width: 100%;
    margin-bottom: 1;
}

.workspace-settings-form, .user-settings-form {
    width: 82;
}

.workspace-members {
    width: 90;
}

#workspace-members-table {
    height: 14;
    margin: 1 0;
}

.recap-prompt-editor {
    width: 90%;
}

#recap-prompt-text {
    height: 1fr;
    min-height: 8;
    border: solid $accent;
    margin-bottom: 1;
}

#recap-prompt-status {
    min-height: 1;
    color: $error;
    margin-bottom: 1;
}

.review-modal {
    height: 90%;
    overflow-y: hidden;
}

.review-body {
    height: 1fr;
    max-height: 1fr;
    overflow-y: hidden;
}

.review-body > .metadata {
    height: 5;
    overflow-y: auto;
}

.review-mappings {
    height: 1fr;
    min-height: 1;
    overflow-y: auto;
}

.review-actions {
    height: auto;
    min-height: 3;
    align: left middle;
}

.review-mapping {
    height: auto;
    border-bottom: solid $secondary;
    padding: 1 0;
}

.review-speaker-label {
    text-style: bold;
}

.review-mode {
    height: 3;
    align: left middle;
}

.review-mode Switch {
    margin: 0 1;
}

.review-error {
    min-height: 1;
    color: $error;
}

#campaigns-table {
    height: 12;
    border: solid $accent;
    margin: 1 0;
}

#campaign-management-status {
    min-height: 1;
    margin: 1 0;
}

.metadata {
    min-height: 5;
    border: solid $secondary;
    padding: 1;
    margin: 1 0;
}

.selected-file {
    min-height: 3;
    border: solid $secondary;
    padding: 0 1;
    margin: 1 0;
    color: $text-muted;
}

#preview-scroll {
    height: 1fr;
    border: none;
}

#console-panel {
    width: 100%;
    height: 12;
    max-height: 40%;
    background: $surface;
    border-top: solid $secondary;
    overflow: hidden hidden;
}

#console-panel.collapsed {
    height: 1;
    border-top: none;
}

#console-toggle {
    width: 100%;
    height: 1;
    min-height: 1;
    border: none;
    padding: 0 1;
    margin: 0;
    content-align: left middle;
}

#console-log {
    height: 1fr;
    padding: 0 1;
}

#progress-panel {
    height: auto;
    margin-top: 1;
}

#progress-stage {
    height: 1;
    text-style: bold;
}

#job-progress {
    height: 1;
}

#progress-time {
    height: 1;
    color: $text-muted;
}
