Screen {
    layout: vertical;
}

#topbar {
    height: 3;
    padding: 0 1;
    background: $panel;
}

#campaign-select {
    width: 1fr;
}

#manage-campaign {
    width: 20;
    margin-left: 1;
}

#status {
    width: 38;
    content-align: right middle;
}

#campaign-actions {
    width: 100%;
    height: auto;
    min-height: 1;
    margin-top: 1;
    padding: 0 1;
    grid-columns: auto;
    grid-rows: 1;
    grid-gutter: 0 1;
    background: $panel;
}

#campaign-actions Button {
    width: auto;
    height: 1;
    min-width: 0;
    border: none;
    padding: 0 1;
}

#dashboard {
    height: 1fr;
    overflow-y: auto;
}

#actions {
    width: 28;
    height: 1fr;
    padding: 1;
    background: $surface;
    overflow-y: auto;
}

#actions Button {
    width: 100%;
    margin-bottom: 1;
}

#content {
    width: 1fr;
    padding: 1;
    overflow-y: auto;
    overflow-x: auto;
}

#content Button {
    width: auto;
    height: 1;
    min-width: 0;
    border: none;
    padding: 0 1;
}

#jobs-header {
    height: 1;
    align: left middle;
}

#jobs-header Label {
    width: 1fr;
    content-align: left middle;
}

#clear-failed-jobs {
    width: auto;
    min-width: 20;
}

.panel {
    height: 1fr;
    border: solid $accent;
    padding: 1;
    margin-bottom: 1;
}

.short-panel {
    height: 12;
}

.modal {
    width: 72;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: thick $accent;
    background: $panel;
}

.modal Button {
    margin-right: 1;
}

#campaigns-table {
    height: 12;
    border: solid $accent;
    margin: 1 0;
}

#campaign-management-status {
    min-height: 1;
    margin: 1 0;
}

.metadata {
    min-height: 5;
    border: solid $secondary;
    padding: 1;
    margin: 1 0;
}

#preview-markdown {
    height: 28;
    border: solid $accent;
    padding: 1;
}
